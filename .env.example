# QuickNode Solana mainnet endpoints (HTTP + WSS)
QUICKNODE_HTTP_URL=https://your-endpoint.solana-mainnet.quiknode.pro/your-token/
QUICKNODE_WSS_URL=wss://your-endpoint.solana-mainnet.quiknode.pro/your-token/

# Path to a JSON keypair file (Solana CLI format: a 64-byte int array), gitignored.
# Generate a fresh burner with: solana-keygen new -o wallet.json
WALLET_KEYPAIR_PATH=./wallet.json

# Set to false only once probe.py, tests, and a DRY_RUN pass all look correct.
DRY_RUN=true
